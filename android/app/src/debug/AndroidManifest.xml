<?xml version="1.0" encoding="utf-8"?>
<!--
  Debug-only overlay. Android's network-security config is static XML and cannot
  whitelist a host chosen at runtime, so debug builds permit cleartext broadly to
  allow plaintext ws://. The release manifest does not reference this file.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application android:networkSecurityConfig="@xml/network_security_config" />
</manifest>
